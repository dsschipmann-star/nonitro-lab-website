# URL pública do site (sem barra final). Usada em metadata, sitemap.xml e Open Graph.
NEXT_PUBLIC_SITE_URL=https://nonitrolab.com.br

# WhatsApp — apenas dígitos, no formato internacional (55 + DDD + número).
# Exemplo (NÃO é real): 5548900000000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Instagram (handle sem @). Opcional.
NEXT_PUBLIC_INSTAGRAM_HANDLE=

# E-mail de contato. Opcional.
NEXT_PUBLIC_CONTACT_EMAIL=
